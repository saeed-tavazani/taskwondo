FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src

ARG GOPROXY
ENV GOPROXY=${GOPROXY}

COPY go.mod go.sum ./
RUN GODEBUG=http2client=0 go mod download

COPY . .

RUN CGO_ENABLED=0 go build -o /bin/montask-worker ./cmd/worker

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /bin/montask-worker /bin/montask-worker

ENTRYPOINT ["/bin/montask-worker"]
