FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src

ARG GOPROXY
ENV GOPROXY=${GOPROXY}

COPY go.mod go.sum ./
RUN GODEBUG=http2client=0 go mod download

COPY . .

ARG COMMIT_SHA=dev
RUN CGO_ENABLED=0 go build -ldflags "-X main.commitSHA=${COMMIT_SHA}" -o /bin/montask ./cmd/server

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /bin/montask /bin/montask

EXPOSE 8080

ENTRYPOINT ["/bin/montask"]
