{
  "manifest_version": "0.1",
  "name": "montask",
  "version": "0.3.0",
  "display_name": "Montask",
  "description": "Project management and work item tracking with Montask",
  "long_description": "Connect Claude Desktop to your Montask instance for full project management capabilities. Create and manage projects, work items, milestones, queues, and more — all from within Claude.",
  "author": {
    "name": "Marcos Hack",
    "url": "https://github.com/marcoshack/taskwondo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcoshack/taskwondo"
  },
  "license": "MIT",
  "server": {
    "type": "binary",
    "entry_point": "server/montask-mcp",
    "mcp_config": {
      "command": "${__dirname}/server/montask-mcp",
      "env": {
        "MONTASK_URL": "${user_config.server_url}",
        "MONTASK_API_KEY": "${user_config.api_key}"
      },
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/server/montask-mcp.exe"
        }
      }
    }
  },
  "user_config": {
    "server_url": {
      "type": "string",
      "title": "Server URL",
      "description": "Your Montask server URL (e.g. https://montask.example.com)",
      "required": true
    },
    "api_key": {
      "type": "string",
      "title": "API Key",
      "description": "Optional: your Montask API key. Leave blank to use browser login instead.",
      "required": false,
      "sensitive": true
    }
  },
  "compatibility": {
    "platforms": ["win32", "darwin"]
  },
  "tools_generated": true,
  "keywords": ["project-management", "work-items", "task-tracking", "montask"]
}
